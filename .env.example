# Copy to .env and fill in what you need. Everything here is optional —
# without any of it the site still serves quotes, charts, indicators and
# backtests; only the AI panel switches off.

# --- Claude (enables the AI analysis panel) --------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# claude-opus-5 is the current Opus tier. claude-sonnet-5 is cheaper and still
# strong; claude-haiku-4-5 is cheapest but noticeably weaker at this task.
CLAUDE_MODEL=claude-opus-5

# low | medium | high | xhigh | max — thinking depth and token spend.
# high is a good default; drop to medium if responses feel slow or costly.
CLAUDE_EFFORT=high

# --- Marketplace crypto payments (optional) --------------------------------
# Get a key at https://beta.commerce.coinbase.com/settings/security
# With it set, paid marketplace items check out through Coinbase Commerce's
# hosted crypto payment page. Without it the purchase flow runs in a
# clearly-labelled demo mode where no value moves.
COINBASE_COMMERCE_API_KEY=

# --- Optional data sources -------------------------------------------------
# yfinance needs no key and covers everything the UI uses today. This key is
# only read by the vendored Alpha Vantage provider.
ALPHA_VANTAGE_KEY=

# --- Server ----------------------------------------------------------------
# Only matters if you serve the frontend from a different origin than the API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
